{
  "name": "docx_metadata_editor",
  "version": "1.0.0",
  "description": "Professional Office Metadata Inspector and Editor (DOCX, PPTX, XLSX)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node run_e2e_verification.js",
    "pack": "electron-packager . \"DocProps Studio\" --platform=win32 --arch=x64 --out=dist --icon=icon.ico --overwrite --prune=true"
  },
  "keywords": [
    "ooxml",
    "docx",
    "pptx",
    "xlsx",
    "metadata",
    "editor",
    "privacy"
  ],
  "author": "pol0234",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pol0234/DocProps-Studio.git"
  },
  "bugs": {
    "url": "https://github.com/pol0234/DocProps-Studio/issues"
  },
  "homepage": "https://github.com/pol0234/DocProps-Studio#readme",
  "dependencies": {
    "gsap": "^3.15.1",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.3",
    "playwright": "^1.65.0"
  }
}
